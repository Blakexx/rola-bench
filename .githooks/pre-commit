#!/usr/bin/env bash
# rola-bench's commit gate, in the tree: `core.hooksPath` points a checkout here (per worktree). It runs
# `bazel test //:gate` on the commit as git will write it (`rola_devtools.graph.front_door`'s `commit_gate`, every RoLA
# repository's), through this workspace's front door.
set -euo pipefail
exec "$(git rev-parse --show-toplevel)/bazel/bazel" --commit-gate
